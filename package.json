{
  "name": "voting",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:web": "vite",
    "pb": "node scripts/pb.ts",
    "build": "run-s build:web build:hooks",
    "build:web": "vite build",
    "build:hooks": "node scripts/build-hooks.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.ts",
    "typegen": "pocketbase-typegen --url $PB_TYPEGEN_URL --email $PB_TYPEGEN_EMAIL --password $PB_TYPEGEN_PASSWORD --out src/lib/pocketbase-types.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:quick": "run-s format:check typecheck lint elections:check test",
    "validate": "run-s validate:quick test:e2e",
    "format-and-validate": "run-s format validate",
    "og": "node scripts/og/render.ts",
    "geo": "node scripts/geo/build.ts",
    "golden": "node scripts/fixtures/golden.ts",
    "elections:check": "node scripts/elections/check.ts",
    "elections:push": "node scripts/elections/push.ts",
    "relay": "node scripts/relay.ts",
    "new-vote": "node scripts/new-vote.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.24.0",
    "pocketbase": "^0.27.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "mapshaper": "^0.7.93",
    "npm-run-all2": "^9.0.2",
    "pocketbase-typegen": "^1.5.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0"
}
